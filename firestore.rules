rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // True when the requesting user is listed in the group's members array.
    function isGroupMember(groupId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.members
             .hasAny([request.auth.uid]);
    }

    // ---------------------------------------------------------------------
    // publicProfiles/{uid}
    //   Denormalized, safe-to-share projection used by the leaderboard,
    //   username -> user resolution (group invites) and public group browsing.
    //   Contains NO email and NO distraction-app list. Owner-writable with a
    //   strict field whitelist; readable by any authenticated user.
    // ---------------------------------------------------------------------
    match /publicProfiles/{userId} {
      allow read: if isSignedIn();

      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys()
             .hasOnly(['uid', 'username', 'name', 'totalFocusMinutes', 'allowGroupInvites', 'updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 64
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.totalFocusMinutes is int
        && request.resource.data.totalFocusMinutes >= 0
        && request.resource.data.allowGroupInvites is bool;

      // Projections are never deleted from the client.
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Usernames/{lowercaseUsername}
    //   Global uniqueness index mapping a username to its owning uid.
    //   Readable by any authenticated user (needed to resolve invites).
    //   Stores ONLY { uid, username } — no email (avoids a world-readable
    //   email index). Immutable once reserved to prevent hijack / re-pointing.
    // ---------------------------------------------------------------------
    match /Usernames/{username} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly(['uid', 'username'])
        && username == username.lower()
        && username.size() >= 3
        && username.size() <= 64;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // users/{userId}  (private profile + all owned subcollections)
    //   Owner-only. This protects email, distractionApps and private stats
    //   from being read by other authenticated users.
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read, delete: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId;

      // Owner may update their own document; the uid field may never be
      // reassigned to a different user.
      allow update: if isOwner(userId)
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId);

      // Group-invite notifications: recipient-owned. A different (signed-in)
      // user may CREATE an invitation addressed to the recipient, but only
      // when they declare themselves as the sender.
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid == userId;
      }

      // Every other user-owned subcollection (sessions, achievements,
      // quizResults, ...): strictly owner read/write.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------------------
    // groups/{groupId}
    //   Public groups are browsable by any authenticated user; private groups
    //   only by members. Subcollections are member-only.
    // ---------------------------------------------------------------------
    match /groups/{groupId} {
      allow read: if isSignedIn()
        && (resource.data.isPublic == true
            || resource.data.members.hasAny([request.auth.uid]));

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members.hasAny([request.auth.uid]);

      allow update: if isSignedIn() && (
        // (a) An existing member editing the group (creator must be preserved).
        (resource.data.members.hasAny([request.auth.uid])
          && request.resource.data.createdBy == resource.data.createdBy)
        ||
        // (b) A non-member JOINING a public group: the only permitted change is
        //     adding exactly themselves to members (no removals, no other edits).
        (resource.data.isPublic == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.hasAny([request.auth.uid])
          && request.resource.data.members.size() == resource.data.members.size() + 1)
      );

      // Groups are never deleted from the client in the current app.
      allow delete: if false;

      match /activities/{activityId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.userUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }

      match /documents/{documentId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.uploadedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Default deny: anything not matched above is inaccessible.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
